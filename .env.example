# ── This .env is for local (non-Docker) development ────────
# For Docker deployment, copy backend/.env.example to backend/.env instead.

DEVELOPMENT_MODE=true
DEBUG=true

DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=changeme
DB_PORT=5432

# LLM API Keys
# Deployment-wide defaults. Users can bring their own in the chat sidebar, so an
# instance where everyone does can leave these blank.
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# Corrective retrieval's news lookup — optional, and also user-supplyable.
NEWS_API_KEY=""

DATABASE_URL=postgresql://myuser:changeme@localhost:5432/crag_db
