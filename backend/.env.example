# ── Django Core ──────────────────────────────────────────────
DEVELOPMENT_MODE=False
DEBUG=False
SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://myuser:changeme@postgres:5432/crag_db

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── LLM API Keys ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Base dataset indexing (optional) ─────────────────────────
# Set to true to embed + index the MultiHop-RAG corpus into ChromaDB on
# startup. Requires OPENROUTER_API_KEY and uses embedding API credits.
# The app works without it — you can always upload your own documents.
INSERT_BASE_DATASET=false

# ── Other API Keys ─────────────────────────────────────────────
NEWS_API_KEY=
