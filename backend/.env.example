# ── Django Core ──────────────────────────────────────────────
DEVELOPMENT_MODE=False
DEBUG=False
SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://myuser:changeme@postgres:5432/crag_db

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── LLM API Keys ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── LangSmith Tracing (optional) ──────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ── Other API Keys ─────────────────────────────────────────────
NEWS_API_KEY=
