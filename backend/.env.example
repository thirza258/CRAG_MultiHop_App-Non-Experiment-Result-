# ── Django Core ──────────────────────────────────────────────
DEVELOPMENT_MODE=False
DEBUG=False
SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend,crag.nevatal.tech

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://myuser:changeme@postgres:5432/crag_db

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Increase for larger deployments; every process loads the ML libraries.
CELERY_WORKER_CONCURRENCY=2

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── LLM API Keys ─────────────────────────────────────────────
# These are the deployment-wide defaults. Users can paste their own keys in the
# chat sidebar, which apply to their requests only and are never stored — so an
# instance where everyone brings their own key can leave these blank.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Base dataset indexing (optional) ─────────────────────────
# Set to true to embed + index the MultiHop-RAG corpus into ChromaDB on
# startup. Requires OPENROUTER_API_KEY and uses embedding API credits.
# The app works without it — you can always upload your own documents.
INSERT_BASE_DATASET=false

# Pre-download the configured local reranker and grader before serving requests.
# Set false for faster startup when those stages are disabled or already cached.
PRELOAD_MODELS=true

# ── Other API Keys ─────────────────────────────────────────────
# Corrective retrieval's recent-news lookup. Optional: without it that one
# lookup is skipped and Wikipedia still runs. Users can supply their own.
NEWS_API_KEY=

# Optional path to server pipeline defaults; defaults to backend/config.yml.
# RAG_CONFIG_FILE=/app/config.yml
